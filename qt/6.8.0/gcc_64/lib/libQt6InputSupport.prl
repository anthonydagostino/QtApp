QMAKE_PRL_TARGET = libQt6InputSupport.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.0
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6DeviceDiscoverySupport.a $$[QT_INSTALL_LIBS]/libQt6Gui.so $$[QT_INSTALL_LIBS]/libQt6Core.so -lxkbcommon
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6DeviceDiscoverySupport.a;$$[QT_INSTALL_LIBS]/libQt6Gui.so;$$[QT_INSTALL_LIBS]/libQt6Core.so;-lxkbcommon
