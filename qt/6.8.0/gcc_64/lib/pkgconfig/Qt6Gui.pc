prefix=/work/qt-sdk/6.8.0/gcc_64
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Gui
Description: Qt Gui module
Version: 6.8.0
Libs: -L${libdir} -lQt6Gui
Cflags: -I${includedir}/QtGui -I${includedir} -DQT_GUI_LIB
Requires: Qt6Core
