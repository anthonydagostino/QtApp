QT_ARCH = x86_64
QT_BUILDABI = x86_64-little_endian-lp64
QT_LIBCPP_ABI_TAG = 
QT.global.enabled_features = version_tagging shared pkg-config rpath reduce_relocations signaling_nan zstd thread future concurrent shared intelcet glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker shared rpath reduce_exports reduce_relocations
QT.global.disabled_features = static cross_compile debug_and_release separate_debug_info appstore-compliant simulator_and_device force_asserts framework c++20 c++2a c++2b wasm-simd128 wasm-exceptions dbus openssl-linked opensslv11 opensslv30
QT.global.disabled_features += release build_all
QT_CONFIG += shared rpath reduce_exports reduce_relocations release
CONFIG += release  shared plugin_manifest intelcet glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker
QT_VERSION = 6.8.0
QT_MAJOR_VERSION = 6
QT_MINOR_VERSION = 8
QT_PATCH_VERSION = 0

QT_GCC_MAJOR_VERSION = 11
QT_GCC_MINOR_VERSION = 5
QT_GCC_PATCH_VERSION = 0
