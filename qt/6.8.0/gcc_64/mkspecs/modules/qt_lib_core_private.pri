QT.core_private.enabled_features = clock-gettime close_range doubleconversion dladdr futimens getauxval getentropy glib icu inotify linkat memmem memrchr mimetype-database poll_ppoll posix_sem posix_shm renameat2 sysv_sem sysv_shm backtrace sha3-fast hijricalendar timezone_locale datetimeparser forkfd_pidfd pcre2 reduce_exports x86intrin sse2 sse3 ssse3 sse4_1 sse4_2 avx f16c avx2 avx512f avx512er avx512cd avx512pf avx512dq avx512bw avx512vl avx512ifma avx512vbmi avx512vbmi2 aesni vaes rdrnd rdseed shani localtime_r posix_fallocate alloca_h alloca gui network printsupport widgets xml dlopen relocatable intelcet glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker largefile precompile_header enable_new_dtags sse2 sse3 ssse3 sse4_1 sse4_2 avx f16c avx2 avx512f avx512er avx512cd avx512pf avx512dq avx512bw avx512vl avx512ifma avx512vbmi avx512vbmi2 aesni vaes rdrnd rdseed shani
